@"TBM1|d2304c391cb1698bb6c4cc6293930c53-16|stm32f4x.cpu|20000000|32|1|12345678|END\n"
16^done
(gdb) 
=thread-exited,id="1",group-id="i1"
=thread-group-exited,id="i1"
