&"file\" command.\n"
=thread-created,id="1",group-id="i1"
~"0x080001f4 in ?? ()\n"
*stopped,frame={addr="0x080001f4",func="??",args=[],arch="arm"},thread-id="1",stopped-threads="all"
11^connected
(gdb) 
@"TBM1|d2304c391cb1698bb6c4cc6293930c53-12|stm32f4x.cpu|20000000|32|1|12345678|END\n"
12^done
(gdb) 
@"TBP_UNRELATED\n"
@"TBM1|d2304c391cb1698bb6c4cc6293930c53-13|stm32f4x.cpu|20000000|32|1|12345678|END\n"
13^done
(gdb) 
@"TBM1|d2304c391cb1698bb6c4cc6293930c53-14|stm32f4x.cpu|20000000|32|1|12345678|END\n"
@"TBM1|d2304c391cb1698bb6c4cc6293930c53-14|stm32f4x.cpu|20000000|32|1|12345678|END\n"
14^done
(gdb) 
@"TBP_EXPECTED_ERROR\n"
&"Protocol error with Rcmd: 01.\n"
15^error,msg="Protocol error with Rcmd: 01."
